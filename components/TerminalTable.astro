---
/*
 * SPDX-FileCopyrightText: Copyright Corsinvest Srl
 * SPDX-License-Identifier: MIT
 *
 * A tool's tabular output, shown the way the terminal shows it: the command on top, a monospace
 * table, coloured severity badges. The cv4pve CLI tools print tables with the same TableGenerator
 * (cv4pve-api-dotnet), so every site can show its output with this.
 *
 * Self-contained markup and scoped styles inside the page content (`not-content`): it touches no
 * Starlight internals, so Starlight upgrades cannot break it.
 */
type Tone = 'critical' | 'warning' | 'info' | 'ok';

interface Column {
  label: string;
  /**
   * `badge` — severity pill, tone from the value (Critical/Warning/Info/Ok) or `tones`;
   * `code` — identifier in blue; `muted` — secondary identifier; `accent` — highlighted value;
   * `wrap` — free text that wraps. Default: plain.
   */
  style?: 'badge' | 'code' | 'muted' | 'accent' | 'wrap';
}

interface Props {
  /** Command that produces the output, shown in the bar on top. */
  command: string;
  columns: Column[];
  /** One array of cell values per row, in column order. */
  rows: string[][];
  /** Tone of each badge value, when it is not one of Critical/Warning/Info/Ok. */
  tones?: Record<string, Tone>;
  /** Note under the table. May contain HTML. */
  note?: string;
}

const { command, columns, rows, tones = {}, note } = Astro.props;
const tone = (value: string): Tone | '' =>
  tones[value] ?? (['critical', 'warning', 'info', 'ok'].includes(value.toLowerCase()) ? (value.toLowerCase() as Tone) : '');
---

<div class="cv-terminal not-content">
  <div class="cv-terminal-bar"><em>{command}</em></div>
  <div class="cv-scroll">
    <table>
      <thead>
        <tr>{columns.map((c) => <th>{c.label}</th>)}</tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              {columns.map((c, i) =>
                c.style === 'badge' ? (
                  <td><span class:list={['cv-badge', tone(row[i] ?? '')]}>{row[i]}</span></td>
                ) : (
                  <td class:list={[c.style && `cv-${c.style}`]}>{row[i]}</td>
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {note && <div class="cv-terminal-foot" set:html={note} />}
</div>

<style>
  .cv-terminal {
    margin: 1rem 0 2rem;
    border: 1px solid var(--cv-card-border);
    border-radius: 8px;
    background: #0b1b2b;
    color: #d6e2ee;
    box-shadow: 0 20px 48px color-mix(in srgb, var(--cv-blue) 25%, transparent);
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }
  .cv-terminal-bar {
    padding: 0.7rem 1rem;
    background: #10263b;
  }
  .cv-terminal-bar em {
    display: block;
    font-style: normal;
    color: #8fa9c2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The real output is wide: scroll sideways on narrow screens rather than wrap. */
  .cv-scroll {
    overflow-x: auto;
    padding: 0.5rem 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
  }
  th {
    padding: 0.4rem 0.75rem;
    text-align: left;
    font-weight: 600;
    color: #8fa9c2;
    border-bottom: 1px solid rgb(125 178 232 / 0.18);
  }
  td {
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid rgb(125 178 232 / 0.06);
  }
  tbody tr:hover {
    background: rgb(42 111 174 / 0.12);
  }
  .cv-code {
    color: #7db2e8;
  }
  .cv-muted {
    color: #a9c4dd;
  }
  .cv-accent {
    color: hsl(var(--sl-hue-orange) 85% 67%);
    font-weight: 600;
  }
  .cv-wrap {
    white-space: normal;
    min-width: 22rem;
  }
  .cv-badge {
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  /* Same hues as the site's badges and asides (--sl-hue-*, set by the theme), with a lightness
     fixed for the dark terminal background in both site themes. */
  .cv-badge.critical {
    background: hsl(var(--sl-hue-red) 65% 55% / 0.18);
    color: hsl(var(--sl-hue-red) 100% 77%);
  }
  .cv-badge.warning {
    background: hsl(var(--sl-hue-orange) 75% 51% / 0.18);
    color: hsl(var(--sl-hue-orange) 85% 67%);
  }
  .cv-badge.info {
    background: hsl(var(--sl-hue-blue) 65% 57% / 0.18);
    color: hsl(var(--sl-hue-blue) 80% 76%);
  }
  .cv-badge.ok {
    background: hsl(var(--sl-hue-green) 50% 52% / 0.18);
    color: hsl(var(--sl-hue-green) 55% 69%);
  }
  .cv-terminal-foot {
    padding: 0.7rem 1rem;
    border-top: 1px solid rgb(125 178 232 / 0.12);
    color: #8fa9c2;
    font-family: var(--sl-font);
    font-size: 0.8rem;
  }
  .cv-terminal-foot :global(code) {
    color: #d6e2ee;
  }

  /* Light theme: a light terminal, so it does not stand out as a black block on a light page.
     Badges use Starlight's -high tokens, which it adapts to the theme, as Severity does. */
  :global(:root[data-theme='light']) .cv-terminal {
    background: #f4f7fb;
    color: #1b2b3b;
    box-shadow: 0 12px 32px color-mix(in srgb, var(--cv-blue) 12%, transparent);
  }
  :global(:root[data-theme='light']) .cv-terminal-bar {
    background: #e6edf5;
  }
  :global(:root[data-theme='light']) .cv-terminal-bar em,
  :global(:root[data-theme='light']) th,
  :global(:root[data-theme='light']) .cv-terminal-foot {
    color: #4a6178;
  }
  :global(:root[data-theme='light']) th {
    border-bottom-color: rgb(26 66 105 / 0.18);
  }
  :global(:root[data-theme='light']) td {
    border-bottom-color: rgb(26 66 105 / 0.07);
  }
  :global(:root[data-theme='light']) tbody tr:hover {
    background: rgb(42 111 174 / 0.07);
  }
  :global(:root[data-theme='light']) .cv-code {
    color: var(--cv-blue-bright);
  }
  :global(:root[data-theme='light']) .cv-muted {
    color: #4a6178;
  }
  :global(:root[data-theme='light']) .cv-accent {
    color: var(--sl-color-orange-high);
  }
  :global(:root[data-theme='light']) .cv-terminal-foot {
    border-top-color: rgb(26 66 105 / 0.12);
  }
  :global(:root[data-theme='light']) .cv-terminal-foot :global(code) {
    color: #1b2b3b;
  }
  :global(:root[data-theme='light']) .cv-badge.critical { color: var(--sl-color-red-high); }
  :global(:root[data-theme='light']) .cv-badge.warning { color: var(--sl-color-orange-high); }
  :global(:root[data-theme='light']) .cv-badge.info { color: var(--sl-color-blue-high); }
  :global(:root[data-theme='light']) .cv-badge.ok { color: var(--sl-color-green-high); }
</style>
