---
/*
 * SPDX-FileCopyrightText: Copyright Corsinvest Srl
 * SPDX-License-Identifier: MIT
 *
 * The skill a cv4pve tool ships for AI assistants, for the page "AI assistants": what it is, what it tells
 * the assistant (the tool's own list, in the slot) and how to install it.
 *
 * The skill is `skills/<tool>/SKILL.md` on master of the tool's repository; the install commands work only
 * once that file is merged. `npx skills add <owner>/<repo>` (skills.sh) finds skills in `skills/`:
 * verified with `skills add <local path> --list`. Skill folders verified on code.claude.com/docs/en/skills
 * and learn.chatgpt.com/docs/build-skills (Codex).
 * No headings here: Starlight builds "On this page" from the page's own headings only.
 */
import { Code } from '@astrojs/starlight/components';

interface Props {
  /** Tool binary and repository name, e.g. `cv4pve-report`. */
  tool: string;
}

const { tool } = Astro.props;
const path = `skills/${tool}/SKILL.md`;
const blob = `https://github.com/Corsinvest/${tool}/blob/master/${path}`;
const raw = `https://raw.githubusercontent.com/Corsinvest/${tool}/master/${path}`;
const manual = [`mkdir -p .claude/skills/${tool}`, `curl -fL -o .claude/skills/${tool}/SKILL.md ${raw}`].join('\n');
---

<p>
  The repository ships a skill, <a href={blob}><code>{path}</code></a>: a short file in the Agent Skills format
  that Claude Code, Codex and other assistants load when a request matches its description. It tells the
  assistant to:
</p>

<slot />

<p>Install it with the <a href="https://skills.sh/">skills</a> command, which needs Node.js:</p>

<Code code={`npx skills add Corsinvest/${tool}`} lang="bash" />

<p>
  Or copy the file into the skills folder of your assistant: <code>.claude/skills/</code> for Claude Code,{' '}
  <code>.agents/skills/</code> for Codex, in the project or under your home folder:
</p>

<Code code={manual} lang="bash" />
