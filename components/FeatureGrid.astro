---
/*
 * SPDX-FileCopyrightText: Copyright Corsinvest Srl
 * SPDX-License-Identifier: MIT
 *
 * Numbered feature cards for the home page, each linking to the page that explains it.
 * A relative href ("checks/") is resolved against the site base; absolute ones are kept.
 * Self-contained markup and scoped styles (`not-content`): no Starlight internals touched.
 */
interface Props {
  items: { title: string; text: string; href: string }[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (href: string) => (/^(https?:)?\//.test(href) ? href : `${base}/${href}`);
const features = Astro.props.items.map((f) => ({ ...f, href: resolve(f.href) }));
---

<div class="cv-features not-content">
  {
    features.map((f, i) => (
      <a class="cv-feature" href={f.href}>
        <span class="cv-feature-num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{f.title}</h3>
        <p>{f.text}</p>
      </a>
    ))
  }
</div>

<style>
  .cv-features {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 3rem;
  }
  @media (min-width: 50rem) {
    .cv-features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 72rem) {
    .cv-features {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cv-feature {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--cv-card-border);
    border-radius: 8px;
    background: var(--cv-card-bg);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .cv-feature:hover {
    border-color: var(--cv-blue-bright);
    transform: translateY(-2px);
  }
  .cv-feature-num {
    font-family: var(--cv-font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cv-blue-bright);
  }
  .cv-feature h3 {
    margin: 0.5rem 0;
    font-size: 1.5rem;
    color: var(--sl-color-white);
  }
  .cv-feature p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
