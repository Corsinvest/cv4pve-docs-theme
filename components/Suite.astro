---
import { Card, CardGrid, LinkCard } from '@astrojs/starlight/components';

/*
 * SPDX-FileCopyrightText: Copyright Corsinvest Srl
 * SPDX-License-Identifier: MIT
 *
 * The cv4pve suite, grouped as on corsinvest.it/en/cv4pve (Cv4pvePage.astro in
 * corsinvest-web): keep names, groups and descriptions in step with that page.
 * Built only from Starlight components (CardGrid, LinkCard, Card), so it follows the site theme.
 * The tool whose site this is is shown as a plain card, without a link to itself.
 */
interface Props {
  current: string;
}

const { current } = Astro.props;

/** Tools that publish a documentation site of their own. */
const DOCS = ['cv4pve-admin', 'cv4pve-api-powershell', 'cv4pve-diag'];
const toolUrl = (name: string) =>
  DOCS.includes(name) ? `https://corsinvest.github.io/${name}/` : `https://github.com/Corsinvest/${name}`;

const groups = [
  {
    title: 'Management',
    tools: [
      { name: 'cv4pve-admin', text: 'Web platform for managing clusters, like vCenter, but for Proxmox VE.' },
      { name: 'cv4pve-cli', text: 'kubectl-style command line with multi-cluster support.' },
      { name: 'cv4pve-api-powershell', text: 'PowerShell module for automating the cluster: the PowerCLI equivalent.' },
      { name: 'cv4pve-report', text: 'Exports the infrastructure to Excel, HTML or JSON. The RVTools equivalent.' },
      { name: 'cv4pve-diag', text: 'Diagnostics and cluster health checks.' },
    ],
  },
  {
    title: 'Continuous protection',
    tools: [
      { name: 'cv4pve-autosnap', text: 'Automatic recurring snapshots of machines and containers, with retention policies.' },
      { name: 'cv4pve-node-protect', text: 'Backup and restore of node configuration: the part machine backups do not cover.' },
    ],
  },
  {
    title: 'Access',
    tools: [
      { name: 'cv4pve-vdi', text: 'Desktop VDI client: SPICE, VNC, RDP and SSH consoles.' },
      { name: 'cv4pve-pepper', text: 'Launches the SPICE viewer from the command line.' },
      { name: 'cv4pve-botgram', text: 'Telegram bot to manage and monitor the cluster from a phone.' },
    ],
  },
  {
    title: 'Monitoring',
    tools: [
      { name: 'cv4pve-metrics-exporter', text: 'Prometheus exporter for nodes, machines, containers and storage.' },
    ],
  },
];

/** One repository per language. */
const libraries = [
  { label: '.NET', repo: 'cv4pve-api-dotnet' },
  { label: 'PowerShell', repo: 'cv4pve-api-powershell' },
  { label: 'PHP', repo: 'cv4pve-api-php' },
  { label: 'Java', repo: 'cv4pve-api-java' },
  { label: 'JavaScript', repo: 'cv4pve-api-javascript' },
];
---

{
  groups.map((g) => (
    <>
      <h3>{g.title}</h3>
      <CardGrid>
        {g.tools.map((t) =>
          t.name === current ? (
            <Card title={t.name} icon="star">{t.text}</Card>
          ) : (
            <LinkCard title={t.name} description={t.text} href={toolUrl(t.name)} target="_blank" rel="noopener noreferrer" />
          ),
        )}
      </CardGrid>
    </>
  ))
}

<h3>API libraries</h3>
<p>The same Proxmox VE API calls, from whichever language you already use.</p>
<CardGrid>
  {libraries.map((l) => <LinkCard title={l.label} href={`https://github.com/Corsinvest/${l.repo}`} target="_blank" rel="noopener noreferrer" />)}
</CardGrid>
