---
/*
 * SPDX-FileCopyrightText: Copyright Corsinvest Srl
 * SPDX-License-Identifier: MIT
 *
 * Connection options shared by the cv4pve CLI tools built on Corsinvest.ProxmoxVE.Api.Console
 * (ConsoleHelper.CreateApp + login options): diag, report, autosnap, pepper, botgram,
 * metrics-exporter. Not for cv4pve-cli (saved contexts), node-protect (SSH) or vdi (GUI).
 *
 * Verified against cv4pve-api-dotnet v9.2.x (CommandOptionExtension.cs, ClientHelper.cs,
 * PveClientBase.cs). Tools on Api.Console 9.1.15 or older do not accept IPv6 in --host.
 * Plain HTML only, so Starlight's content styles apply.
 */
interface Props {
  /** Example user for --username, e.g. `diag@pve`. */
  user?: string;
}

const { user = 'user@pve' } = Astro.props;
---

<table>
  <thead>
    <tr><th>Option</th><th>What it does</th></tr>
  </thead>
  <tbody>
    <tr>
      <td><code>--host</code></td>
      <td>
        One or more nodes, comma-separated: <code>pve1,pve2:8006,[fe80::1]</code>. The port defaults to
        8006. At startup the first node that accepts a connection is used, so the tool runs while a node
        is down; if the login on that node fails, the others are not tried. Any node gives the view of
        the whole cluster.
      </td>
    </tr>
    <tr>
      <td><code>--api-token</code></td>
      <td>
        <code>USER@REALM!TOKENID=UUID</code>, Proxmox VE 6.2 or later. Recommended. Quote it on the command
        line: <code>!</code> is special in bash.
      </td>
    </tr>
    <tr>
      <td><code>--username</code> / <code>--password</code></td>
      <td>
        Alternative to the token, e.g. <code>--username={user}</code> (without a realm, <code>pam</code> is
        used). Accounts with two-factor authentication cannot log in this way — use a token.
        <code>--password=file:/path/secret</code> asks for the password the first time and saves it in that
        file <strong>obfuscated, not encrypted</strong> (the key is built into the tool): protect the file like
        the password itself.
      </td>
    </tr>
    <tr>
      <td><code>--validate-certificate</code></td>
      <td>
        Verify the node TLS certificate. <strong>Off by default</strong>, so the default self-signed Proxmox
        certificate is accepted — turn it on if the nodes have a trusted certificate.
      </td>
    </tr>
  </tbody>
</table>

<p>
  The options you repeat can go in a file, passed with <code>@</code>. On error the tool prints <code>ERROR: …</code> and exits with code 1.
</p>
